{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "~/assets/*": ["sites/drlurie/assets/*"],
      "~/*": ["packages/core/app/*"],
      "@core/*": ["packages/core/*"],
      "@site/*": ["sites/drlurie/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist/"]
}

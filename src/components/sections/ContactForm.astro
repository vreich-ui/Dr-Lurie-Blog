---
/**
 * `contact_form` section component — a Netlify Forms contact form (A§2.8). The
 * posting identity (formName), heading, and disclaimer are data; the field
 * furniture (name/email/message, labels, submit wording) is a fixed affordance
 * of "a contact form" owned here, mirroring newsletter_signup's Netlify markup
 * (hidden form-name input, data-netlify, post to /thank-you?form=<name>). No
 * references to resolve (EmptyResolved).
 */
import type { EmptyResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'contact_form'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
const fieldClass =
  'mt-2 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-md dark:border-gray-700 dark:bg-slate-950';
const nameId = `${data.formName}-name`;
const emailId = `${data.formName}-email`;
const messageId = `${data.formName}-message`;
---

<section class="mx-auto max-w-3xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  <h2 class="text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>
  {data.subtitle && <p class="mt-3 max-w-2xl text-muted">{data.subtitle}</p>}
  {data.description && <p class="mt-2 max-w-2xl text-sm text-muted">{data.description}</p>}
  <form
    name={data.formName}
    method="post"
    action={`/thank-you?form=${data.formName}`}
    data-netlify="true"
    class="mt-6"
    aria-label={`${data.heading} form`}
  >
    <input type="hidden" name="form-name" value={data.formName} />
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <label for={nameId} class="block text-sm font-medium">Name</label>
        <input id={nameId} name="name" type="text" required class={fieldClass} />
      </div>
      <div>
        <label for={emailId} class="block text-sm font-medium">Email</label>
        <input id={emailId} name="email" type="email" required autocomplete="email" class={fieldClass} />
      </div>
    </div>
    <div class="mt-4">
      <label for={messageId} class="block text-sm font-medium">Message</label>
      <textarea id={messageId} name="message" rows="4" required class={fieldClass}></textarea>
    </div>
    <button type="submit" class="btn-primary mt-6">Send message</button>
  </form>
  {data.disclaimer && <p class="mt-4 max-w-2xl text-sm text-muted">{data.disclaimer}</p>}
</section>

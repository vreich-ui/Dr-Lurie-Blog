---
/**
 * `product_preview` section component (S2) — a heading over a card grid of
 * PRODUCTS. `manual`/`query` sources arrive resolved to product cards
 * (title/excerpt/image/price badge/href → /shop/<slug>); a `cards` source
 * renders its curated cells from data with per-cell action hrefs. The
 * component owns only layout; which products appear (and never a retired or
 * coming_soon one) is the resolver's contract.
 */
import type { ProductPreviewResolved, RenderCtx, SectionDataOf } from '@core/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'product_preview'>;
  resolved: ProductPreviewResolved;
  ctx: RenderCtx;
};

const { data, resolved } = Astro.props;
const curated = data.source.kind === 'cards' ? data.source.cards : [];
const actionClass = (style?: 'primary' | 'secondary' | 'link') =>
  style === 'secondary' ? 'btn-secondary' : style === 'link' ? 'btn-link' : 'btn-primary';
---

<section class="dl-section">
  <h2 class="text-3xl font-bold tracking-tight text-heading sm:text-4xl">{data.heading}</h2>
  <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      (resolved.cards ?? []).map((card) => (
        <article class="dl-card flex flex-col">
          {card.image && (
            <img
              class="mb-4 aspect-video w-full rounded-md object-cover"
              src={card.image.src}
              alt={card.image.alt}
              loading="lazy"
            />
          )}
          <h3 class="text-xl font-semibold text-heading">
            <a href={card.href}>{card.title}</a>
          </h3>
          {card.excerpt && <p class="mt-2 text-muted grow">{card.excerpt}</p>}
          <p class="mt-4 flex items-center justify-between">
            <span class="font-bold text-heading">{card.priceBadge}</span>
            <a class="btn-secondary" href={card.href}>
              View
            </a>
          </p>
        </article>
      ))
    }
    {
      curated.map((cell, index) => (
        <article class="dl-card flex flex-col">
          <h3 class="text-xl font-semibold text-heading">{cell.title}</h3>
          {cell.description && <p class="mt-2 text-muted">{cell.description}</p>}
          {cell.action && resolved.cardHrefs?.[index] && (
            <a
              class:list={['mt-6', actionClass(cell.action.style)]}
              href={resolved.cardHrefs[index]}
              set:text={cell.action.label}
            />
          )}
        </article>
      ))
    }
  </div>
</section>

---
/**
 * `comparison_table` section component (W10 T10.6). A bounded feature
 * matrix — cells align to columns index-wise; a missing cell renders as an
 * em dash (defensive: the schema bounds lengths but does not couple them).
 */
import type { EmptyResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'comparison_table'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;

const cellText = (cell: boolean | string | undefined): string =>
  cell === undefined || cell === '' ? '—' : cell === true ? '✓' : cell === false ? '—' : cell;
---

<section id={data.anchor} class="mx-auto max-w-5xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  {
    (data.kicker || data.heading) && (
      <div class="max-w-2xl">
        {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
        {data.heading && (
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>
        )}
      </div>
    )
  }
  <div class="mt-8 overflow-x-auto">
    <table class="w-full border-collapse text-left">
      <thead>
        <tr>
          <th class="w-1/3 pb-3"></th>
          {
            data.columns.map((column) => (
              <th class:list={['pb-3 text-sm font-semibold', column.highlighted ? 'text-accent' : 'text-heading']}>
                {column.label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          data.rows.map((row) => (
            <tr class="border-t border-gray-200 dark:border-gray-800">
              <th class="py-3 pr-4 text-sm font-medium text-default">{row.label}</th>
              {data.columns.map((column, columnIndex) => (
                <td class:list={['py-3 pr-4 text-sm', column.highlighted ? 'font-medium text-default' : 'text-muted']}>
                  {cellText(row.cells[columnIndex])}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

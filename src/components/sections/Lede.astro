---
/**
 * `lede` section component (T4.2) — markup verbatim from the audited interior
 * standalone pages (start-here, newsletter, member-updates, free-guide,
 * early-access, A§2.x): a kicker + h1 + intro paragraph(s) + action buttons.
 * Same field shape as `hero` but a lighter interior presentation (font-semibold
 * kicker, tighter tracking, muted lg body) — a distinct pattern, its own
 * component. Receives {data, resolved, ctx} like every registry component;
 * action hrefs arrive resolved by the renderer.
 *
 * The action container gains flex classes only when there is more than one
 * button (single-button pages ship a bare `mt-8`, exactly as audited).
 */
import { splitRichTextParagraphs } from '~/lib/richtext/paragraphs';
import type { HeroResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'lede'>;
  resolved: HeroResolved;
  ctx: RenderCtx;
};

const { data, resolved } = Astro.props;
const paragraphs = splitRichTextParagraphs(data.body ?? '');
const actionClass = (style?: 'primary' | 'secondary' | 'link') =>
  style === 'secondary' ? 'btn-secondary' : style === 'link' ? 'btn-link' : 'btn-primary';
---

<section id={data.anchor} class="mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-20">
  {data.kicker && <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{data.kicker}</p>}
  <h1 class="mt-3 text-4xl font-bold tracking-tight text-heading sm:text-5xl">{data.heading}</h1>
  {paragraphs.map((paragraph) => <p class="mt-5 text-lg leading-8 text-muted" set:html={paragraph} />)}
  {
    /* Whitespace inside an inline <a> widens its underline; keep it out with
       set:text and the explicit ' ' between sibling anchors (see Hero.astro). */
    data.actions.length > 0 && (
      <div class:list={['mt-8', { 'flex flex-col gap-3 sm:flex-row': data.actions.length > 1 }]}>
        {data.actions.map((action, index) => (
          <Fragment>
            {index > 0 && ' '}
            <a class={actionClass(action.style)} href={resolved.actionHrefs[index]} set:text={action.label} />
          </Fragment>
        ))}
      </div>
    )
  }
</section>

---
/**
 * `steps` section component (W5) — an ordered process strip: numbered (or
 * iconed) titled steps in a responsive row. The component owns only layout.
 */
import { Icon } from 'astro-icon/components';

import type { EmptyResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'steps'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
// T10.6 ratified variant: 2|3|4 columns via a pre-built class map (rule 6 —
// never interpolated); absent = 3 = today's classes byte-exactly.
const COLUMNS_CLASS: Record<2 | 3 | 4, string> = {
  2: 'mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2',
  3: 'mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3',
  4: 'mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4',
};
const columnsClass = COLUMNS_CLASS[data.columns ?? 3];
---

<section class="dl-section">
  <div class="max-w-2xl">
    {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
    {data.heading && <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>}
  </div>
  <ol class={columnsClass}>
    {
      data.items.map((item, index) => (
        <li class="dl-card">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent/10 font-bold text-accent">
            {item.icon ? <Icon name={item.icon} class="h-5 w-5" /> : index + 1}
          </span>
          <h3 class="mt-4 text-lg font-semibold text-heading">{item.title}</h3>
          {item.description && <p class="mt-2 text-muted">{item.description}</p>}
        </li>
      ))
    }
  </ol>
</section>

---
/**
 * `prose` section component — a reader-width block of body copy, rendered in the
 * site's `.dl-reading` editorial container so its typography (serif, 18px/1.82,
 * paragraph rhythm) comes from the design system rather than per-paragraph
 * classes. A general-purpose text section an agent can place on any page; it
 * owns only layout, receiving {data, resolved, ctx} like every registry
 * component. Body is TipTap paragraphs (the D§3.5 richtext allowlist); the
 * splitter refuses anything but top-level <p> blocks rather than drop it.
 */
import { splitRichTextBlocks } from '~/lib/richtext/paragraphs';
import type { EmptyResolved, RenderCtx, SectionDataOf } from '@core/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'prose'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
const blocks = splitRichTextBlocks(data.body);
---

<section class="dl-section">
  <div class="dl-reading">
    {
      blocks.map((block) => {
        const Tag = block.tag;
        return <Tag set:html={block.html} />;
      })
    }
  </div>
</section>

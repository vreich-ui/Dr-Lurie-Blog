---
/**
 * `checklist` section component (T3.2) — markup verbatim from the audited
 * "This is for you if…" homepage section (index.astro, A§2.1). One card per
 * item; kicker/heading/anchor are data (M-9).
 */
import type { EmptyResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'checklist'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
---

<section id={data.anchor} class="mx-auto max-w-5xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  <div class="max-w-2xl">
    {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
    {data.heading && <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>}
  </div>
  <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      data.items.map((item) => (
        <article class="rounded-2xl border border-gray-200 bg-white p-5 text-default dark:border-gray-800 dark:bg-slate-900">
          <p>{item}</p>
        </article>
      ))
    }
  </div>
</section>

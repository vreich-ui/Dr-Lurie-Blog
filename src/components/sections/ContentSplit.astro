---
/**
 * `content_split` section component (W5) — text + media split. The layout is
 * the generalized form of the retired hand-coded shop-preview hero (its
 * scoped grid/stagger styles moved here, keyed off generic classes): copy
 * column (kicker/heading/paragraphs/actions) beside 1–2 images, the second
 * image staggered on wide screens and hidden on phones. `reverse` flips the
 * columns. Paragraph-only body (the renderability check enforces it).
 */
import { splitRichTextParagraphs } from '~/lib/richtext/paragraphs';
import type { ContentSplitResolved, RenderCtx, SectionDataOf } from '@core/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'content_split'>;
  resolved: ContentSplitResolved;
  ctx: RenderCtx;
};

const { data, resolved } = Astro.props;
const paragraphs = splitRichTextParagraphs(data.body);
const actionClass = (style?: 'primary' | 'secondary' | 'link') =>
  style === 'secondary' ? 'btn-secondary' : style === 'link' ? 'btn-link' : 'btn-primary';
const hasImages = data.images.length > 0;
// T10.6 ratified variant: 'stagger' (= absent, today's offset second image
// byte-exactly) or 'stack' (both images flush, second visible on mobile).
const stagger = (data.imageLayout ?? 'stagger') === 'stagger';
---

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20">
  <div
    class:list={[
      'grid items-center gap-10',
      hasImages ? 'lg:grid-cols-[minmax(0,0.92fr)_minmax(420px,1fr)] lg:gap-x-16' : '',
    ]}
  >
    <div class:list={[data.reverse && hasImages ? 'lg:order-2' : '']}>
      {data.kicker && <p class="text-sm font-semibold uppercase tracking-[0.18em] text-accent">{data.kicker}</p>}
      <h2 class="mt-4 max-w-3xl text-4xl font-bold sm:text-5xl">{data.heading}</h2>
      <div class="mt-7 max-w-2xl text-lg text-muted lg:max-w-xl">
        {paragraphs.map((paragraph, index) => <p class:list={[index > 0 ? 'mt-4' : '']} set:html={paragraph} />)}
      </div>
      {
        data.actions.length > 0 && (
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            {data.actions.map((action, index) => (
              <a class:list={[actionClass(action.style)]} href={resolved.actionHrefs[index]} set:text={action.label} />
            ))}
          </div>
        )
      }
    </div>
    {
      hasImages && (
        <div class:list={['grid gap-3 sm:grid-cols-2', data.reverse ? 'lg:order-1' : '']}>
          {data.images.map((image, index) => (
            <figure
              class:list={[
                'overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900',
                index === 1 ? (stagger ? 'hidden sm:block lg:translate-y-8' : '') : '',
              ]}
            >
              <img
                class="h-full min-h-[220px] w-full object-cover"
                src={image.src}
                alt={image.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>

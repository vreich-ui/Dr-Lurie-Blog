---
/**
 * `content_grid` section component (T3.2/T3.9) — markup verbatim from the
 * audited "Start here" homepage grid (index.astro, A§2.1). `static` renders
 * its cards verbatim (transitional, T3.2, byte-identical cutover, C§1.7-1).
 * `manual`/`query` render from `resolved.cards`, computed by the renderer
 * (src/lib/renderer/resolve.ts via resolve-content-grid.ts, M-8) — this
 * component stays a pure layout consumer of already-resolved cards, same
 * discipline as every other registry component.
 */
import { splitRichTextParagraphs } from '~/lib/richtext/paragraphs';
import type { ContentGridResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'content_grid'>;
  resolved: ContentGridResolved;
  ctx: RenderCtx;
};

const { data, resolved } = Astro.props;
// An empty manual list with no fallback is an intentionally short grid
// (resolve-content-grid.ts's own documented rule) — render nothing, not an error.
const cards = data.source.kind === 'static' ? data.source.cards : (resolved.cards ?? []);
const intro = splitRichTextParagraphs(data.body ?? '');
---

<section id={data.anchor} class="mx-auto max-w-5xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  <div class="max-w-2xl">
    {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
    {data.heading && <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>}
    {intro.map((paragraph) => <p class="mt-4 text-muted" set:html={paragraph} />)}
  </div>
  <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      cards.map((card, index) => (
        <article class="rounded-2xl border border-gray-200 bg-gray-50 p-6 dark:border-gray-800 dark:bg-slate-900">
          <p class="text-sm font-medium text-accent">Article {index + 1}</p>
          <h3 class="mt-3 text-xl font-semibold text-heading">{card.title}</h3>
          <p class="mt-3 text-muted">{card.description}</p>
        </article>
      ))
    }
  </div>
</section>

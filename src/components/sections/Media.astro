---
/**
 * `media` section component (W10 T10.5). Standalone image/gallery/video
 * block in the site's section rhythm. THE SAFETY POSTURE: video embed URLs
 * are built HERE from a fixed per-provider template over the regex-pinned
 * videoId — data never carries a URL; a drifted id fails the schema before
 * it reaches this interpolation, and the template re-asserts the regex.
 */
import { MEDIA_VIDEO_ID_RE } from '~/schema/bodies/section-v1';
import type { EmptyResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'media'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
const layout = data.layout ?? 'single';

const EMBED_TEMPLATES: Record<'youtube' | 'vimeo', (id: string) => string> = {
  youtube: (id) => `https://www.youtube-nocookie.com/embed/${id}`,
  vimeo: (id) => `https://player.vimeo.com/video/${id}`,
};

const embedSrc = (provider: 'youtube' | 'vimeo', videoId: string): string => {
  if (!MEDIA_VIDEO_ID_RE.test(videoId)) {
    throw new Error(`media: video id ${JSON.stringify(videoId)} fails ${String(MEDIA_VIDEO_ID_RE)} at render.`);
  }
  return EMBED_TEMPLATES[provider](videoId);
};

const gridClass =
  layout === 'grid'
    ? 'mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2'
    : layout === 'strip'
      ? 'mt-8 flex gap-4 overflow-x-auto'
      : 'mt-8 space-y-8';
---

<section id={data.anchor} class="mx-auto max-w-5xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  {
    (data.kicker || data.heading) && (
      <div class="max-w-2xl">
        {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
        {data.heading && (
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>
        )}
      </div>
    )
  }
  <div class={gridClass}>
    {
      data.items.map((item) => (
        <figure class={layout === 'strip' ? 'w-72 flex-none' : ''}>
          {item.kind === 'image' ? (
            <img src={item.src} alt={item.alt} loading="lazy" class="w-full rounded-2xl object-cover" />
          ) : (
            <div class="aspect-video overflow-hidden rounded-2xl">
              <iframe
                src={embedSrc(item.provider, item.videoId)}
                title={item.title}
                loading="lazy"
                allow="encrypted-media; picture-in-picture"
                allowfullscreen
                class="h-full w-full border-0"
              />
            </div>
          )}
          {item.caption && <figcaption class="mt-2 text-sm text-muted">{item.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</section>

---
/**
 * `search` section component — a site-search box over a JSON index route
 * (A§2.8, the Header search overlay extracted into a placeable section). The
 * index route is data (`indexRoute`, e.g. /search.json); the box furniture is
 * owned here. The inline script fetches the index once and filters by title,
 * rendering result links (index shape: {title, excerpt, permalink}, matching
 * src/pages/search.json.ts). No references to resolve (EmptyResolved).
 */
import type { EmptyResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'search'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
const placeholder = data.placeholder ?? 'Search the site';
---

<section class="dl-section">
  <div role="search" class="max-w-xl">
    <label class="sr-only" for="site-search-input">{placeholder}</label>
    <input
      id="site-search-input"
      type="search"
      placeholder={placeholder}
      autocomplete="off"
      class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-md dark:border-gray-700 dark:bg-slate-950"
      data-site-search-input
    />
    <ul class="mt-4 space-y-2" data-site-search-results></ul>
  </div>
</section>

<script is:inline define:vars={{ indexRoute: data.indexRoute }}>
  (() => {
    const input = document.querySelector('[data-site-search-input]');
    const results = document.querySelector('[data-site-search-results]');
    if (!input || !results) return;
    let index = null;
    const load = async () => {
      if (index) return index;
      try {
        const response = await fetch(indexRoute);
        index = await response.json();
      } catch {
        index = [];
      }
      return Array.isArray(index) ? index : [];
    };
    input.addEventListener('input', async () => {
      const query = input.value.trim().toLowerCase();
      results.replaceChildren();
      if (!query) return;
      const matches = (await load())
        .filter((item) =>
          String(item.title ?? '')
            .toLowerCase()
            .includes(query)
        )
        .slice(0, 8);
      for (const item of matches) {
        const li = document.createElement('li');
        const anchor = document.createElement('a');
        anchor.href = `/${item.permalink}`;
        anchor.textContent = item.title ?? '';
        anchor.className = 'text-lg font-medium text-accent hover:underline';
        li.appendChild(anchor);
        results.appendChild(li);
      }
    });
  })();
</script>

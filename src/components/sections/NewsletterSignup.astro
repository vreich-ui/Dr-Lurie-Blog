---
/**
 * `newsletter_signup` section component (T3.2) — markup verbatim from the
 * audited homepage Netlify form (index.astro, A§2.4). Copy slots
 * (kicker/heading/body/consentText) and the posting identity (formName) are
 * data; the form furniture — email label, placeholder, submit wording,
 * aria-label — is a fixed affordance of "a newsletter signup" owned here.
 * The global submit-mirroring to save-opt-in stays layout chrome (C§1.5).
 */
import { splitRichTextParagraphs } from '~/lib/richtext/paragraphs';
import type { EmptyResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'newsletter_signup'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
const paragraphs = splitRichTextParagraphs(data.body ?? '');
const emailInputId = `${data.formName}-email`;
---

<section id={data.anchor} class="mx-auto max-w-5xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  <div class="rounded-3xl border border-gray-200 bg-white p-6 sm:p-8 dark:border-gray-800 dark:bg-slate-900">
    <div class="max-w-2xl">
      {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">
        {data.heading}
      </h2>
      {paragraphs.map((paragraph) => <p class="mt-4 text-muted" set:html={paragraph} />)}
    </div>
    <form
      name={data.formName}
      method="post"
      action={`/thank-you?form=${data.formName}`}
      data-netlify="true"
      class="mt-6 max-w-xl"
      aria-label="Newsletter signup form"
    >
      <input type="hidden" name="form-name" value={data.formName} />
      <label for={emailInputId} class="block text-sm font-medium">Email address</label>
      <div class="mt-2 flex flex-col gap-3 sm:flex-row">
        <input
          id={emailInputId}
          name="email"
          type="email"
          required
          autocomplete="email"
          class="min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-4 py-3 text-md dark:border-gray-700 dark:bg-slate-950"
          placeholder="you@example.com"
        />
        <button type="submit" class="btn-primary">Join Newsletter</button>
      </div>
    </form>
    {data.consentText && <p class="mt-4 text-sm text-muted">{data.consentText}</p>}
  </div>
</section>

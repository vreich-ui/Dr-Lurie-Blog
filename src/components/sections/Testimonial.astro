---
/**
 * `testimonial` section component (T3.13 extensibility drill). Follows the
 * site's established section rhythm (top-divider, max-w-5xl, kicker/heading
 * lead-in, two-column card grid) so a placed testimonial section sits
 * consistently among the audited sections. Receives {data, resolved, ctx}
 * like every registry component; it owns only layout and classes.
 */
import type { EmptyResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'testimonial'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
---

<section id={data.anchor} class="mx-auto max-w-5xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  <div class="max-w-2xl">
    {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
    {data.heading && <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>}
  </div>
  <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      data.quotes.map((quote) => (
        <figure class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-slate-900">
          <blockquote class="text-lg leading-8 text-default">{quote.quote}</blockquote>
          {quote.attribution && (
            <figcaption class="mt-4 text-sm font-medium text-muted">{quote.attribution}</figcaption>
          )}
        </figure>
      ))
    }
  </div>
</section>

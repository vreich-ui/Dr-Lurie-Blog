---
/**
 * `cta_banner` section component — a closing call-to-action: optional heading +
 * optional supporting copy + one or more action buttons. A general-purpose
 * conversion block an agent can place at the end of any page. Action hrefs
 * arrive resolved by the renderer (HeroResolved.actionHrefs, aligned by index),
 * exactly like hero/lede — the component owns only layout.
 *
 * The action container gains flex classes only when there is more than one
 * button (single-button placements ship a bare `mt-8`, matching hero/lede).
 */
import { splitRichTextParagraphs } from '~/lib/richtext/paragraphs';
import type { HeroResolved, RenderCtx, SectionDataOf } from '~/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'cta_banner'>;
  resolved: HeroResolved;
  ctx: RenderCtx;
};

const { data, resolved } = Astro.props;
const paragraphs = splitRichTextParagraphs(data.body ?? '');
const actionClass = (style?: 'primary' | 'secondary' | 'link') =>
  style === 'secondary' ? 'btn-secondary' : style === 'link' ? 'btn-link' : 'btn-primary';
---

<section class="dl-section">
  {data.heading && <h2 class="text-3xl font-bold tracking-tight text-heading sm:text-4xl">{data.heading}</h2>}
  {paragraphs.map((paragraph) => <p class="mt-4 max-w-2xl text-lg text-muted" set:html={paragraph} />)}
  {
    /* Whitespace inside an inline <a> widens its underline; keep it out with
       set:text and the explicit ' ' between sibling anchors (see Hero.astro). */
    data.actions.length > 0 && (
      <div class:list={['mt-8', { 'flex flex-col gap-3 sm:flex-row': data.actions.length > 1 }]}>
        {data.actions.map((action, index) => (
          <Fragment>
            {index > 0 && ' '}
            <a class={actionClass(action.style)} href={resolved.actionHrefs[index]} set:text={action.label} />
          </Fragment>
        ))}
      </div>
    )
  }
</section>

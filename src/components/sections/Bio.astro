---
/**
 * `bio` section component (T3.2) — the reusable "person intro" (the audited
 * "Meet Dr. Lurié" homepage section, A§2.1, and the /about intro since the
 * 2026-07-10 decomposition). The lead paragraph class belongs to this
 * component (first body paragraph renders large); trust notes render as
 * accent-bordered lines; the disclaimer is data (M-9). An optional `portrait`
 * ({src, alt}) renders a photo under the heading — a bio without one renders
 * exactly as before (the homepage bio has none). `portraitAssetRef` remains
 * the schema-legal trusted-artifact path, still unrendered until a design uses it.
 */
import { splitRichTextParagraphs } from '~/lib/richtext/paragraphs';
import type { EmptyResolved, RenderCtx, SectionDataOf } from '@core/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'bio'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
const paragraphs = splitRichTextParagraphs(data.body);
---

<section id={data.anchor} class="mx-auto max-w-5xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-[0.9fr_1.1fr]">
    <div>
      {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
      <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>
      {
        data.portrait && (
          <img
            src={data.portrait.src}
            alt={data.portrait.alt}
            class="mt-6 h-auto w-full rounded-lg object-cover"
            loading="lazy"
          />
        )
      }
    </div>
    <div>
      {paragraphs.map((paragraph) => <p class="text-lg leading-8 text-default" set:html={paragraph} />)}
      {
        data.trustNotes.length > 0 && (
          <ul class="mt-6 space-y-3 text-muted">
            {data.trustNotes.map((note) => (
              <li class="border-l-2 border-accent/40 pl-4">{note}</li>
            ))}
          </ul>
        )
      }
      {data.disclaimer && <p class="mt-6 text-sm text-muted">{data.disclaimer}</p>}
    </div>
  </div>
</section>

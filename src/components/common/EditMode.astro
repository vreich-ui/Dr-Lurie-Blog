---
/**
 * Edit-mode canvas loader — included once in Layout.astro, dormant for
 * visitors. The inline pre-check reads the GoTrue localStorage key directly
 * (the literal mirrors STORAGE_KEY in src/utils/goTrueClient.ts) so a page
 * with no admin session pays ~0: no editor chunk is fetched, no network call
 * is made. When the key exists, the real gate runs in
 * src/lib/edit-mode/index.ts — token refresh + server-side admin-auth-state —
 * before anything mounts.
 */
---

<script>
  const boot = () => {
    try {
      // Pre-check only; bootEditMode re-verifies via goTrueClient + admin-auth-state.
      if (!localStorage.getItem('dr-lurie-gotrue-user')) return;
    } catch {
      return;
    }
    // T14.0: the edit-mode bundle reaches goTrueClient + media-policy, both of
    // which resolve through provider seams that throw until the site bindings
    // are registered. Loaded dynamically, in front of the editor chunk, so a
    // visitor with no admin session still pays nothing.
    import('~/config/policy-bindings')
      .then(() => import('@core/lib/edit-mode/index'))
      .then((module) => module.bootEditMode());
  };
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

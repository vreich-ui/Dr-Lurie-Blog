---
/**
 * ObjectSections (W6) — renders a bare list of page-object sections through
 * the component registry, for surfaces that own their page shell (the listing
 * loaders, the article route) and place object sections AROUND derived
 * furniture instead of delegating the whole page to PageObjectRenderer.
 *
 * Never-render-private (A§1.1) is enforced in resolveSections itself; the
 * pre-filter here only avoids loading resolver deps (shared targets, posts)
 * for sections that will not render anyway. Pass the already-interpolated
 * sections (loadRoutePageObject applies the `%term%` token before handing
 * them over). Renders nothing for an empty list, so wiring this into a route
 * is byte-identical until an agent actually adds a section.
 *
 * `objectId` names the page object that owns `sections`; every dispatched
 * section is wrapped in a display:contents identity annotation
 * (section-annotations.ts) the admin edit-mode canvas reads. No box is
 * generated — visitor-facing layout is untouched.
 */
import { buildSectionResolveDeps, type SectionResolveContext } from '~/components/cms/section-resolve-deps';
import { getRegisteredComponent } from '~/lib/registry/components/index';
import { resolveSections } from '~/lib/renderer/resolve';
import { sectionAnnotationAttrs } from '~/lib/renderer/section-annotations';
import type { SectionInstance } from '~/schema/bodies/section-v1';

interface Props {
  objectId: string;
  sections: SectionInstance[];
  /** Surface context for resolution (e.g. the article route's current post, anchoring `related` grids). */
  context?: SectionResolveContext;
}
const { objectId, sections, context } = Astro.props;

const visible = sections.filter((section) => section.visibility !== 'hidden');
const deps = visible.length > 0 ? await buildSectionResolveDeps(visible, context) : undefined;
const renderables = deps ? resolveSections(visible, deps) : [];
---

{
  renderables.map((section) => {
    const { component: SectionComponent } = getRegisteredComponent(section.type);
    return (
      <div style="display:contents" {...sectionAnnotationAttrs(objectId, section)}>
        <SectionComponent data={section.data} resolved={section.resolved} ctx={section.ctx} />
      </div>
    );
  })
}
{
  /* Zero rendered sections: an inert zero-height anchor so the edit-mode
     canvas can still offer its add-section "+" for this page object (a
     display:contents element has no box to position against). Without it an
     object-empty page has no gap mounts and an editor could never add the
     FIRST section from the canvas. Visitors see nothing. */
  renderables.length === 0 && <div style="height:0" data-cms-empty-object={objectId} />
}

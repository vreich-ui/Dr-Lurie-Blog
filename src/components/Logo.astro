---
import { getSiteObject } from '~/utils/site-object';

export interface Props {
  text?: string;
}

// W4: the default logo text comes from the site object (logo.text), falling
// back to the pre-conversion literal when the export is absent. An explicit
// `text` prop still wins.
const site = getSiteObject();
const { text = site?.logo.text ?? 'DR. LURIÉ SCIENCE' } = Astro.props;
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-xl md:text-lg font-semibold tracking-[0.22em] text-gray-900 whitespace-nowrap dark:text-white"
>
  {text}
</span>

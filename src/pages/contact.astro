---
/**
 * Contact (faithful cutover) — delegates to the shared PageObjectRenderer, which
 * loads the published page_contact object and renders its `contact` section: the
 * hero, the Netlify contact form, and the "how we can help" grid, all composed
 * from the same audited widgets, now driven by CMS-object data.
 */
import PageObjectRenderer from '~/components/cms/PageObjectRenderer.astro';
---

<PageObjectRenderer objectId="page_contact" />

---
import AdminNav from '~/components/admin/AdminNav.astro';
import Layout from '~/layouts/PageLayout.astro';

// Static build serves ONE shell at /admin/objects/lookup; netlify.toml rewrites
// every /admin/objects/* request to it (same pattern as /admin/review/[draftId],
// which this page otherwise mirrors — see A§1.3). The real object id is read
// client-side from the URL, never from Astro.params.
export function getStaticPaths() {
  return [{ params: { objectId: 'lookup' } }];
}

const pageTitle = 'Review Object';
const metadata = {
  title: pageTitle,
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <section class="objects-page mx-auto max-w-[980px] px-4 py-10 sm:px-6 sm:py-14">
    <header class="objects-header">
      <div>
        <p class="objects-kicker">Admin workspace</p>
        <h1 id="objects-title">{pageTitle}</h1>
        <p class="objects-intro">
          See what an agent (or another editor) changed, approve or request changes, and — where you hold a publish role
          — publish.
        </p>
      </div>
    </header>

    <p class="auth-status" data-auth-status aria-live="polite" role="status"></p>

    <!-- Shown when signed out -->
    <div data-admin-signin-prompt hidden class="admin-gate-panel">
      <p class="objects-kicker">Admin login required</p>
      <p class="admin-gate-message">Sign in with your editor account to review objects.</p>
      <button type="button" class="btn-primary admin-gate-btn" data-admin-open-login>Sign in to editor</button>
    </div>

    <!-- Shown when signed in but not an admin -->
    <div data-admin-forbidden-prompt hidden class="admin-gate-panel">
      <p class="objects-kicker">Access restricted</p>
      <p class="admin-gate-message">You are signed in, but this email is not listed in ADMIN_EMAILS.</p>
    </div>

    <div data-admin-shell data-auth-gated hidden>
      <AdminNav activePath="/admin/objects" />

      <!--
        TODO (Wolf, 2026-07-08, NOT NOW — captured for T3.10/T3.12): this lookup
        requires already knowing the exact object id (type + id, exact match).
        There is no search/browse across objects. Two improvements to make
        together when this page is next worked:
          1. Real search/filter — list objects by type with a text filter over
             id/title/labels, not just object_inventory's raw sweep; probably a
             typeahead over object_list/object_inventory results.
          2. Render the object as an editable inline preview on this page
             (approximating how it'll actually look — e.g. a nav's groups/
             actions, a page's sections) rather than only the raw JSON/diff
             view, so reviewing and light-editing don't require reading raw
             object bodies.
        See docs/cms-architecture/05-task-breakdown-and-open-questions.md
        (T3.10/T3.12 notes) for the same TODO tracked centrally.
      -->
      <!-- Lookup form: shown until a real object id is resolved from the URL -->
      <section id="lookup-panel" class="objects-card" hidden>
        <p class="objects-kicker">Open an object</p>
        <form id="lookup-form" class="lookup-form">
          <label>
            Type
            <select id="lookup-type">
              <option value="page">page</option>
              <option value="section">section</option>
              <option value="navigation">navigation</option>
              <option value="taxonomy">taxonomy</option>
              <option value="template">template</option>
              <option value="site">site</option>
            </select>
          </label>
          <label>
            Object id
            <input id="lookup-id" type="text" placeholder="nav_footer" required />
          </label>
          <button type="submit" class="btn-primary">Open</button>
        </form>
      </section>

      <!-- Tier 1 objects (articles) are out of scope: they keep the existing editor -->
      <section id="tier1-panel" class="objects-card" hidden>
        <p class="objects-kicker">This is a content item</p>
        <p>Articles are reviewed in the existing article editor, not here.</p>
        <a class="btn-secondary" href="/admin/publish">Open the article editor</a>
      </section>

      <section id="not-found-panel" class="objects-card" hidden>
        <p class="objects-kicker">Not found</p>
        <p id="not-found-message">This object could not be loaded.</p>
      </section>

      <section id="object-workspace" hidden>
        <header class="workspace-header">
          <div>
            <span id="object-tier-badge" class="tier-badge"></span>
            <h2 id="object-heading"></h2>
            <p id="object-subheading" class="objects-intro"></p>
          </div>
        </header>

        <section id="lock-bar" class="objects-card lock-bar">
          <span id="lock-status">Checking lock…</span>
          <div class="lock-actions">
            <button type="button" id="checkout-btn" class="btn-secondary">Check out</button>
            <button type="button" id="checkin-btn" class="btn-secondary" hidden>Check in</button>
          </div>
        </section>

        <section id="impact-preview-panel" class="objects-card" hidden>
          <p class="objects-kicker">Impact</p>
          <p id="impact-preview-text"></p>
        </section>

        <section class="objects-card">
          <p class="objects-kicker">Pending field changes</p>
          <div id="field-diff-list" class="diff-list"></div>
          <p id="field-diff-empty" class="hint">No pending field-level changes.</p>
        </section>

        <section class="objects-card">
          <p class="objects-kicker">Pending structural changes</p>
          <div id="structural-diff-list" class="diff-list"></div>
          <p id="structural-diff-empty" class="hint">No pending structural changes.</p>
        </section>

        <section id="review-status-panel" class="objects-card">
          <p class="objects-kicker">Review status</p>
          <p id="review-state-text"></p>
          <div id="decisions-list"></div>
        </section>

        <section class="objects-card action-bar">
          <p class="objects-kicker">Actions</p>
          <div class="action-buttons">
            <button type="button" id="submit-review-btn" class="btn-secondary" hidden>Submit for review</button>
            <button type="button" id="request-changes-btn" class="btn-secondary" hidden>Request changes</button>
            <button type="button" id="approve-btn" class="btn-secondary" hidden>Approve</button>
            <button type="button" id="publish-btn" class="btn-primary" hidden>Publish</button>
          </div>
          <p id="action-status" class="hint" aria-live="polite"></p>
        </section>

        <section class="objects-card">
          <p class="objects-kicker">History</p>
          <ol id="history-list" class="history-list"></ol>
        </section>
      </section>
    </div>
  </section>
</Layout>

<style>
  .objects-page {
    color: var(--aw-color-text-default);
  }

  /*
   * .btn-primary/.btn-secondary (tailwind.css) set `display: inline-flex` at
   * the same specificity as the UA `[hidden] { display: none }` rule, so
   * without this override a hidden button using those classes still renders
   * (author CSS beats UA CSS at equal specificity) — caught by manually
   * driving this page in a browser, not by any unit test.
   */
  .objects-page [hidden] {
    display: none !important;
  }

  .objects-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgb(229 231 235);
  }

  :global(.dark) .objects-header {
    border-color: rgb(30 41 59);
  }

  .objects-kicker {
    margin: 0 0 0.4rem;
    color: var(--aw-color-accent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .objects-intro,
  .hint {
    color: var(--aw-color-text-muted);
    font-size: 0.95rem;
  }

  .auth-status {
    margin: -0.75rem 0 1.5rem;
    color: var(--aw-color-text-muted);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .admin-gate-panel {
    padding: 2rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .admin-gate-message {
    max-width: 36rem;
    color: var(--aw-color-text-muted, #64748b);
  }

  .objects-card {
    border: 1px solid rgb(229 231 235);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.86);
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
  }

  :global(.dark) .objects-card {
    border-color: rgb(30 41 59);
    background: rgb(15 23 42 / 0.76);
  }

  .lookup-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
  }

  .lookup-form label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .lookup-form input,
  .lookup-form select {
    border: 1px solid rgb(209 213 219);
    border-radius: 0.5rem;
    padding: 0.5rem 0.65rem;
  }

  .workspace-header {
    margin-bottom: 1rem;
  }

  .tier-badge {
    display: inline-block;
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgb(94 140 138 / 16%);
    color: var(--aw-color-text-heading);
    margin-bottom: 0.5rem;
  }

  .lock-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lock-actions {
    display: flex;
    gap: 0.5rem;
  }

  .diff-list > * + * {
    margin-top: 0.5rem;
  }

  .structural-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgb(229 231 235);
  }

  :global(.dark) .structural-entry {
    border-color: rgb(30 41 59);
  }

  .structural-entry:last-child {
    border-bottom: none;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0.5rem 0;
  }

  .history-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1.1rem;
    font-size: 0.85rem;
    color: var(--aw-color-text-muted);
  }
</style>

<script>
  // eslint-disable-next-line @typescript-eslint/ban-ts-comment
  // @ts-nocheck
  import { currentUser, getAccessToken, handleOAuthCallback } from '~/utils/goTrueClient';
  import { LockManager } from '~/lib/admin/lock-manager';
  import { computeStructuralDiff, pendingHistory } from '~/lib/admin/structural-diff';
  import { renderFieldDiff, computeFieldDiffEntries } from '~/lib/admin/field-diff';
  import { reviewerAvailableActions } from '~/lib/admin/object-review-ui';

  (() => {
    const OBJECT_ENDPOINT = '/.netlify/functions/admin-object';
    const PREFIX_TO_TYPE = {
      site_: 'site',
      page_: 'page',
      sec_: 'section',
      nav_: 'navigation',
      tax_: 'taxonomy',
      tpl_: 'template',
      prod_: 'product',
      req_: 'content_item',
    };

    const inferObjectType = (id) => {
      for (const [prefix, type] of Object.entries(PREFIX_TO_TYPE)) {
        if (id.startsWith(prefix)) return type;
      }
      return undefined;
    };

    const initializeObjectsPage = () => {
      const pageRoot = document.querySelector('.objects-page');
      if (!pageRoot || pageRoot.dataset.objectsPageInitialized === 'true') return;
      pageRoot.dataset.objectsPageInitialized = 'true';

      const el = (id) => document.getElementById(id);
      const gatedContent = Array.from(document.querySelectorAll('[data-auth-gated]'));
      const adminShell = document.querySelector('[data-admin-shell]');
      const authStatus = document.querySelector('[data-auth-status]');
      const signinPrompt = document.querySelector('[data-admin-signin-prompt]');
      const forbiddenPrompt = document.querySelector('[data-admin-forbidden-prompt]');

      let accessToken = null;
      let currentRoles = [];
      let objectType;
      let objectId;
      let record;
      let lockManager;
      let lockState = { held: false };

      const setGatedContentVisible = (visible) => gatedContent.forEach((node) => (node.hidden = !visible));
      const setAdminShellVisible = (visible) => {
        if (adminShell) adminShell.hidden = !visible;
      };
      const setAuthStatus = (message) => {
        if (authStatus) authStatus.textContent = message;
      };

      const setAuthState = (state) => {
        const isSignedIn = state === 'signed-in';
        setAuthStatus(
          state === 'checking' ? 'Checking editor access…' : state === 'error' ? 'Something went wrong.' : ''
        );
        setAdminShellVisible(isSignedIn);
        setGatedContentVisible(isSignedIn);
        if (signinPrompt) signinPrompt.hidden = state !== 'signed-out';
        if (forbiddenPrompt) forbiddenPrompt.hidden = state !== 'forbidden';
        if (isSignedIn) resolveObjectFromUrl();
      };

      document.querySelector('[data-admin-open-login]')?.addEventListener('click', () => {
        window.__drLurieLoginModal?.open();
      });

      const getToken = async () => accessToken ?? '';

      const callObject = async (body) => {
        const token = await getToken();
        const res = await fetch(OBJECT_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify(body),
        });
        return { status: res.status, body: await res.json().catch(() => ({})) };
      };

      // ─── lookup / URL resolution ──────────────────────────────────────────

      const showOnly = (idsToShow) => {
        ['lookup-panel', 'tier1-panel', 'not-found-panel', 'object-workspace'].forEach((id) => {
          const node = el(id);
          if (node) node.hidden = !idsToShow.includes(id);
        });
      };

      const resolveObjectFromUrl = () => {
        const segment = decodeURIComponent(window.location.pathname.split('/').filter(Boolean).at(-1) || '');
        if (!segment || segment === 'lookup') {
          showOnly(['lookup-panel']);
          return;
        }
        // ?type= is an explicit override (from the lookup form) for ids whose
        // prefix doesn't resolve; prefix inference is the default otherwise.
        const declaredType = new URLSearchParams(window.location.search).get('type');
        const inferred = declaredType || inferObjectType(segment);
        if (inferred === 'content_item') {
          showOnly(['tier1-panel']);
          return;
        }
        if (!inferred) {
          el('not-found-message').textContent =
            `Could not infer an object type from id "${segment}". Use the lookup form.`;
          showOnly(['lookup-panel', 'not-found-panel']);
          return;
        }
        objectType = inferred;
        objectId = segment;
        loadObject();
      };

      el('lookup-form')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const type = el('lookup-type').value;
        const id = el('lookup-id').value.trim();
        if (!id) return;
        window.location.href = `/admin/objects/${encodeURIComponent(id)}?type=${type}`;
      });

      // ─── load + render ─────────────────────────────────────────────────────

      const loadObject = async () => {
        const result = await callObject({ action: 'get', object_type: objectType, object_id: objectId });
        if (result.status !== 200 || !result.body.record) {
          el('not-found-message').textContent = `${objectType} "${objectId}" was not found.`;
          showOnly(['not-found-panel']);
          return;
        }
        record = result.body.record;
        showOnly(['object-workspace']);
        // Only build the LockManager once per object: it retains the lock
        // token in memory across reloads (e.g. after a discard or a review
        // decision), which is what lets `status()` correctly report "you
        // still hold it" without a fresh checkout. Recreating it on every
        // reload would discard that token and misreport the lock as free.
        if (!lockManager) setupLockManager();
        await refreshLockStatus();
        render();
      };

      const setupLockManager = () => {
        lockManager = new LockManager(objectId, getToken, {
          endpoint: OBJECT_ENDPOINT,
          buildRequestBody: (action, id, fields) => ({
            action: action === 'refresh' ? 'refresh_lock' : action,
            object_type: objectType,
            object_id: id,
            ...(fields.lockToken !== undefined ? { lock_token: fields.lockToken } : {}),
            ...(fields.leaseSeconds !== undefined ? { lease_seconds: fields.leaseSeconds } : {}),
          }),
        });
        lockManager.setOnStateChange((state) => {
          lockState = state;
          renderLockBar();
          renderActionBar();
          // The structural-diff list's Discard buttons are disabled while the
          // lock isn't held (T0.6 discard requires the reviewer's lock) — a
          // lock state change (checkout/lost lease) must re-render them too.
          if (record) renderStructuralDiffs();
        });
        lockManager.attachUnloadHandler();
      };

      const refreshLockStatus = async () => {
        lockState = await lockManager.status();
        renderLockBar();
      };

      const renderLockBar = () => {
        const status = el('lock-status');
        const checkoutBtn = el('checkout-btn');
        const checkinBtn = el('checkin-btn');
        if (lockState.held) {
          status.textContent = `You hold the lock (expires ${lockState.expires_at}).`;
          checkoutBtn.hidden = true;
          checkinBtn.hidden = false;
        } else if (lockState.agentLock) {
          status.textContent = `Locked by ${lockState.agentLock.owner_label} until ${lockState.agentLock.expires_at}.`;
          checkoutBtn.hidden = false;
          checkinBtn.hidden = true;
        } else {
          status.textContent = 'Not checked out.';
          checkoutBtn.hidden = false;
          checkinBtn.hidden = true;
        }
      };

      el('checkout-btn')?.addEventListener('click', async () => {
        await lockManager.checkout();
      });
      el('checkin-btn')?.addEventListener('click', async () => {
        await lockManager.checkin();
      });

      const setActionStatus = (message) => {
        el('action-status').textContent = message;
      };

      const render = () => {
        el('object-tier-badge').textContent = ['navigation', 'taxonomy', 'site'].includes(objectType)
          ? 'Tier 3 — human-executed'
          : 'Tier 2 — approval required';
        el('object-heading').textContent = `${objectType} ${objectId}`;
        el('object-subheading').textContent = `content_revision ${record.content_revision} · version ${record.version}`;

        const impactPanel = el('impact-preview-panel');
        if (['navigation', 'site'].includes(objectType)) {
          impactPanel.hidden = false;
          el('impact-preview-text').textContent =
            objectType === 'navigation'
              ? 'Publishing this navigation instance affects every page that renders it as chrome (header/footer) — the truthful stub until per-page usage is computed (surface 3, P3).'
              : 'Publishing the Site object affects brand tokens, metadata defaults, and chrome site-wide.';
        } else {
          impactPanel.hidden = true;
        }

        renderFieldDiffs();
        renderStructuralDiffs();
        renderReviewStatus();
        renderHistory();
        renderActionBar();
      };

      const renderFieldDiffs = () => {
        const list = el('field-diff-list');
        list.innerHTML = '';
        const entries = computeFieldDiffEntries(pendingHistory(record.history));
        el('field-diff-empty').hidden = entries.length > 0;
        for (const entry of entries) {
          for (const leaf of entry.leaves) {
            list.append(renderFieldDiff(`${entry.action}: ${leaf.field}`, leaf.oldValue, leaf.newValue));
          }
        }
      };

      const renderStructuralDiffs = () => {
        const list = el('structural-diff-list');
        list.innerHTML = '';
        const entries = computeStructuralDiff(pendingHistory(record.history));
        el('structural-diff-empty').hidden = entries.length > 0;
        for (const entry of entries) {
          const row = document.createElement('div');
          row.className = 'structural-entry';
          const label = document.createElement('span');
          label.textContent = entry.label;
          row.append(label);

          const actions = document.createElement('div');
          actions.className = 'lock-actions';

          const acceptBtn = document.createElement('button');
          acceptBtn.type = 'button';
          acceptBtn.className = 'btn-secondary';
          acceptBtn.textContent = 'Accept';
          acceptBtn.title = 'This change already lives in the draft — Accept just dismisses it from the pending list.';
          acceptBtn.addEventListener('click', () => {
            row.remove();
          });

          const discardBtn = document.createElement('button');
          discardBtn.type = 'button';
          discardBtn.className = 'btn-secondary';
          discardBtn.textContent = 'Discard';
          discardBtn.disabled = !lockState.held;
          discardBtn.addEventListener('click', async () => {
            if (!lockState.held) return;
            discardBtn.disabled = true;
            const result = await callObject({
              action: 'discard',
              object_type: objectType,
              object_id: objectId,
              lock_token: lockState.lockToken,
              entries: [entry.entry],
            });
            if (result.status === 200) {
              await loadObject();
            } else {
              setActionStatus(result.body.error || 'Discard failed.');
              discardBtn.disabled = false;
            }
          });

          actions.append(acceptBtn, discardBtn);
          row.append(actions);
          list.append(row);
        }
      };

      const renderReviewStatus = () => {
        el('review-state-text').textContent = record.review
          ? `State: ${record.review.state}`
          : 'Not yet submitted for review.';
        const decisionsList = el('decisions-list');
        decisionsList.innerHTML = '';
        for (const decision of record.review?.decisions ?? []) {
          const row = document.createElement('p');
          row.className = 'hint';
          const byLabel = decision.by.kind === 'human' ? decision.by.email : decision.by.agent_name;
          row.textContent = `${decision.decision} by ${byLabel} at ${decision.at} (pinned content_revision ${decision.content_revision}${decision.publish_action ? `, publish_action: ${JSON.stringify(decision.publish_action)}` : ''})`;
          decisionsList.append(row);
        }
      };

      const renderHistory = () => {
        const list = el('history-list');
        list.innerHTML = '';
        for (const entry of record.history) {
          const li = document.createElement('li');
          const actorLabel = entry.actor.kind === 'human' ? entry.actor.email : entry.actor.agent_name;
          li.textContent = `${entry.at} — ${entry.action} (${actorLabel})`;
          list.append(li);
        }
      };

      const renderActionBar = () => {
        const availability = reviewerAvailableActions({
          objectType,
          principalKind: 'human',
          roles: currentRoles,
          hasActiveLock: lockState.held === true,
          review: record?.review,
          contentRevision: record?.content_revision ?? 0,
        });

        el('submit-review-btn').hidden = !availability.canSubmitForReview;
        el('request-changes-btn').hidden = !availability.canRequestChanges;
        el('approve-btn').hidden = !availability.canApprove;
        el('publish-btn').hidden = !availability.canPublish;
      };

      el('submit-review-btn')?.addEventListener('click', async () => {
        if (!lockState.held) return;
        const result = await callObject({
          action: 'submit_review',
          object_type: objectType,
          object_id: objectId,
          lock_token: lockState.lockToken,
        });
        setActionStatus(result.status === 200 ? 'Submitted for review.' : result.body.error || 'Submit failed.');
        if (result.status === 200) await loadObject();
      });

      el('approve-btn')?.addEventListener('click', async () => {
        const result = await callObject({
          action: 'review_decide',
          object_type: objectType,
          object_id: objectId,
          decision: 'approve',
        });
        setActionStatus(result.status === 200 ? 'Approved.' : result.body.error || 'Approve failed.');
        if (result.status === 200) await loadObject();
      });

      el('request-changes-btn')?.addEventListener('click', async () => {
        const result = await callObject({
          action: 'review_decide',
          object_type: objectType,
          object_id: objectId,
          decision: 'request_changes',
        });
        setActionStatus(result.status === 200 ? 'Changes requested.' : result.body.error || 'Request failed.');
        if (result.status === 200) await loadObject();
      });

      el('publish-btn')?.addEventListener('click', async () => {
        if (!lockState.held) {
          setActionStatus('Check out the object before publishing.');
          return;
        }
        const result = await callObject({
          action: 'publish_by_time',
          object_type: objectType,
          object_id: objectId,
          lock_token: lockState.lockToken,
        });
        setActionStatus(result.status === 200 ? 'Published.' : result.body.error || 'Publish failed.');
        if (result.status === 200) await loadObject();
      });

      // ─── identity bootstrap (verbatim pattern from admin/index.astro) ──────

      const getAdminStateForUser = async () => {
        const token = await getAccessToken();
        if (!token) return { authenticated: false, isAdmin: false, roles: [] };
        accessToken = token;
        const response = await fetch('/.netlify/functions/admin-auth-state', {
          method: 'GET',
          headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
        });
        return response.json().catch(() => ({ authenticated: true, isAdmin: false, roles: [] }));
      };

      const renderAuthState = async () => {
        const user = currentUser();
        if (!user) {
          setAuthState('signed-out');
          return;
        }
        const adminState = await getAdminStateForUser();
        if (adminState.isAdmin) {
          currentRoles = adminState.roles ?? [];
          setAuthState('signed-in');
          return;
        }
        setAuthState('forbidden');
      };

      const initializeIdentityAuth = async () => {
        setAuthState('checking');
        try {
          const oauthUser = await handleOAuthCallback();
          if (oauthUser) window.__drLurieLoginModal?.close();
          await renderAuthState();
          document.addEventListener('dr-lurie:login', () => renderAuthState());
          document.addEventListener('dr-lurie:logout', () => renderAuthState());
        } catch (error) {
          console.error('Identity authentication initialization failed.', error);
          setAuthState('error');
        }
      };

      initializeIdentityAuth();
    };

    if (!window.__drLurieObjectsPageLoadListener) {
      window.__drLurieObjectsPageLoadListener = true;
      document.addEventListener('astro:page-load', initializeObjectsPage);
    }

    initializeObjectsPage();
  })();
</script>

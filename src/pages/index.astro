---
/**
 * Homepage (T3.6 cutover) — a thin loader over the published `page_home` Page
 * object. It reads the derived export, resolves it (src/lib/renderer/resolve.ts:
 * shared_ref dereference, hero action hrefs, page metadata), and dispatches
 * each section to its registered component (src/lib/registry/components). The
 * proven section markup is unchanged; only who FEEDS it moved from inline
 * literals to the CMS object. The T2.5 interim footer bridge is gone — the
 * footer variant now comes from page_home.navigationOverrides.footer (S-4).
 */
import { getEntry } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import Footer from '~/components/widgets/Footer.astro';
import { getRegisteredComponent } from '~/lib/registry/components/index';
import { parsePageExport, parseSharedSectionExport, resolvePage, type ResolvePageDeps } from '~/lib/renderer/resolve';
import type { NavTarget } from '~/schema/bodies/navigation-v1';
import { createNavTargetResolver, navigationToFooterProps, parseNavigationExport } from '~/utils/navigation-data';
import { getBlogPermalink, getPermalink } from '~/utils/permalinks';

const pageEntry = await getEntry('pageObject', 'page_home');
if (!pageEntry) {
  throw new Error(
    'index: the published page_home export is missing (src/data/site/pages/page_home.json). ' +
      'The T3.5 publish must land before the T3.6 cutover builds.'
  );
}
const page = parsePageExport(pageEntry.data);

// Hero action hrefs resolve exactly as the audited homepage did — route/asset
// targets through getPermalink, listing to the blog permalink, external
// verbatim. Only route-kind exists in the seed; the rest keep the homepage
// honest as targets are upgraded (T3.11/T4.5).
const resolveActionHref = (target: NavTarget): string => {
  switch (target.kind) {
    case 'route':
    case 'asset':
      return getPermalink(target.href);
    case 'external':
      return target.href;
    case 'listing':
      return getBlogPermalink();
    default:
      throw new Error(`index: hero action target kind '${target.kind}' is not resolvable on the homepage yet.`);
  }
};

// Pre-load every shared_ref target so the pure resolver gets a sync lookup.
const sharedSectionCache = new Map<string, ReturnType<typeof parseSharedSectionExport>>();
for (const section of page.sections) {
  if (section.type !== 'shared_ref') continue;
  const refId = section.data.section;
  if (sharedSectionCache.has(refId)) continue;
  const sectionEntry = await getEntry('sectionObject', refId);
  if (!sectionEntry) {
    throw new Error(`index: shared section export '${refId}' is missing (src/data/site/sections/${refId}.json).`);
  }
  sharedSectionCache.set(refId, parseSharedSectionExport(sectionEntry.data));
}

const deps: ResolvePageDeps = {
  resolveActionHref,
  resolveSharedSection: (sectionObjectId) => {
    const resolved = sharedSectionCache.get(sectionObjectId);
    if (!resolved) throw new Error(`index: shared section '${sectionObjectId}' was not preloaded.`);
    return resolved;
  },
};

const { metadata, sections } = resolvePage(page, deps);

// Footer variant (S-4): the homepage footer comes from the page's
// navigationOverrides.footer (nav_footer_home), replacing T2.5's interim
// direct reference. The <Fragment slot="footer"> mechanism is unchanged.
const footerNavId = page.navigationOverrides?.footer;
if (!footerNavId) {
  throw new Error('index: page_home.navigationOverrides.footer is required for the homepage footer variant.');
}
const footerEntry = await getEntry('navigationObject', footerNavId);
if (!footerEntry) {
  throw new Error(`index: the footer navigation export '${footerNavId}' is missing.`);
}
const homeFooterData = navigationToFooterProps(
  parseNavigationExport(footerEntry.data),
  createNavTargetResolver({ blogPermalink: getBlogPermalink() })
);
---

<Layout metadata={metadata}>
  {
    sections.map((section) => {
      const { component: SectionComponent } = getRegisteredComponent(section.type);
      return <SectionComponent data={section.data} resolved={section.resolved} ctx={section.ctx} />;
    })
  }

  <Fragment slot="footer">
    <Footer {...homeFooterData} />
  </Fragment>
</Layout>

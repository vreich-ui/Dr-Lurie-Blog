---
/**
 * Homepage — a thin loader over the published `page_home` Page object,
 * delegating to the same PageObjectRenderer every migrated route uses
 * (load → resolve → dispatch; the footer variant comes from
 * page_home.navigationOverrides.footer, S-4). The former inline loader
 * duplicated PageObjectRenderer verbatim and crashed the whole build when the
 * footer override went missing (2026-07-10 incident); the renderer falls back
 * to the default footer instead, and the `structure_home_footer` validation
 * rule guards the override at the store boundary where it belongs.
 */
import PageObjectRenderer from '~/components/cms/PageObjectRenderer.astro';
---

<PageObjectRenderer objectId="page_home" />

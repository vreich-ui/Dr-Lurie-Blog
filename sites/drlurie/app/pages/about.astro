---
/**
 * About — a thin loader that delegates to the shared PageObjectRenderer, which
 * loads the published page_about object and renders its sections. page_about is
 * composed from reusable objects (a bio intro, six prose blocks, and a
 * cta_banner close, referenced via shared_ref) — the bespoke `about` section
 * type it once used was retired 2026-07-10.
 */
import PageObjectRenderer from '~/components/cms/PageObjectRenderer.astro';
---

<PageObjectRenderer objectId="page_about" />

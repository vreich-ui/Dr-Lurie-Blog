---
/**
 * `stats` section component (W10 T10.5). A band of headline numbers in the
 * site's section rhythm — large value, label, optional sublabel.
 */
import type { EmptyResolved, RenderCtx, SectionDataOf } from '@core/lib/registry/components/types';

type Props = {
  data: SectionDataOf<'stats'>;
  resolved: EmptyResolved;
  ctx: RenderCtx;
};

const { data } = Astro.props;
---

<section id={data.anchor} class="mx-auto max-w-5xl border-t border-gray-200 px-4 py-14 sm:px-6 dark:border-gray-800">
  {
    (data.kicker || data.heading) && (
      <div class="max-w-2xl">
        {data.kicker && <p class="text-sm font-medium uppercase tracking-[0.16em] text-accent">{data.kicker}</p>}
        {data.heading && (
          <h2 class="mt-3 text-2xl font-bold tracking-tight text-heading sm:text-3xl">{data.heading}</h2>
        )}
      </div>
    )
  }
  <dl class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-6">
    {
      data.items.map((item) => (
        <div class="flex flex-col">
          <dd class="order-1 text-3xl font-bold tracking-tight text-heading">{item.value}</dd>
          <dt class="order-2 mt-1 text-sm font-medium text-default">{item.label}</dt>
          {item.sublabel && <p class="order-3 mt-0.5 text-xs text-muted">{item.sublabel}</p>}
        </div>
      ))
    }
  </dl>
</section>

---
// Maintenance (T9.24 reskin of /admin/blobs) — Owner-only blob browser,
// diagnostics, and wipe tools, on AdminLayout. Server-side Owner gate landed
// at T9.4 (admin-blob-manager / admin-blob-store-diagnostics); this page
// wires the client to it.
import '@site/config/policy-bindings'; // D2: register the site-identity provider before resolving it below
import { getSiteIdentity } from '@core/lib/site-identity';
import AdminLayout from '~/layouts/AdminLayout.astro';
import MaintenancePage from '~/admin/MaintenancePage';

// D2: resolve identity once, server-side, where process.env is real, and
// pass it down explicitly — the island must not call getSiteIdentity()
// itself (the browser has no process.env, so env overrides never reached it).
const identity = getSiteIdentity();
---

<AdminLayout title="Admin — Maintenance">
  <MaintenancePage client:load identity={identity} />
</AdminLayout>

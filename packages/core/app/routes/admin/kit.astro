---
// T9.1 → T9.2 → T9.3 — the admin UI kit gallery. Was its own hand-duplicated
// PageLayout + auth-gate markup/script (drifted from every sibling admin
// route); now uses the shared AdminLayout the same way studio.astro does —
// AdminLayout owns the sign-in/forbidden gate, KitGallery (the React island)
// owns the AdminShell chrome + the light/dark component gallery.
import '@site/config/policy-bindings'; // D2: register the site-identity provider before resolving it below
import { getSiteIdentity } from '@core/lib/site-identity';
import AdminLayout from '~/layouts/AdminLayout.astro';
import KitGallery from '~/admin/KitGallery';

// D2: resolve identity once, server-side, where process.env is real, and
// pass it down explicitly — the island must not call getSiteIdentity()
// itself (the browser has no process.env, so env overrides never reached it).
const identity = getSiteIdentity();
---

<AdminLayout title="Admin UI Kit">
  <KitGallery client:load identity={identity} />
</AdminLayout>

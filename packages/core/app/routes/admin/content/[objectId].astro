---
// Object workspace (T9.9) — the chat-first single-object surface (forms-parity
// floor). A single placeholder page; the netlify.toml rewrite serves it for
// every /admin/content/<id>, and the island reads the id client-side from the
// URL (same pattern as /admin/objects/*).
import '@site/config/policy-bindings'; // D2: register the site-identity provider before resolving it below
import { getSiteIdentity } from '@core/lib/site-identity';
import AdminLayout from '~/layouts/AdminLayout.astro';
import ObjectWorkspace from '~/admin/ObjectWorkspace';

export function getStaticPaths() {
  return [{ params: { objectId: '__workspace' } }];
}

// D2: resolve identity once, server-side, where process.env is real, and
// pass it down explicitly — the island must not call getSiteIdentity()
// itself (the browser has no process.env, so env overrides never reached it).
const identity = getSiteIdentity();
---

<AdminLayout title="Admin — Object">
  <ObjectWorkspace client:load identity={identity} />
</AdminLayout>

---
/**
 * NOT-FOUND ALTERNATIVES (W14 F6, Wolf's ruling 3).
 *
 * "even a default 404 needs to have alternatives to what was not found."
 *
 * A retired route never reaches this component — `object_retire` writes a 301
 * for it, so those readers are forwarded. This is the OTHER kind of miss: a
 * mistyped URL, a stale external link, a page that never existed. On a DTC
 * sales-and-publishing site, showing such a reader a dead end and nothing else
 * is a lost reader, so the 404 offers somewhere to go.
 *
 * The alternatives are the site's OWN primary navigation, read from the same
 * published navigation object the header renders — so they are per-tenant and
 * correct by construction, with no hardcoded fleet copy (the mistake F3 caught
 * in the footer).
 */
import { getEntry } from 'astro:content';

import { getSiteObject } from '~/utils/site-object';
import { getHomePermalink } from '~/utils/permalinks';
import { navigationToHeaderProps, parseNavigationExport } from '~/utils/navigation-data';
import { buildSiteNavTargetResolver } from '~/utils/site-nav-targets';

const site = getSiteObject();
const headerNavId = site?.defaultNavigation?.header ?? 'nav_header';

const resolve = await buildSiteNavTargetResolver();
let links: Array<{ text?: string; href?: string }> = [];
try {
  const entry = await getEntry('navigationObject', headerNavId);
  if (entry) {
    // Flattened top-level entries (post-F3) already carry text+href; a dropdown
    // group contributes its children instead, so the reader gets real
    // destinations rather than an unclickable menu label.
    links = navigationToHeaderProps(parseNavigationExport(entry.data), resolve).links.flatMap((link) =>
      link.links?.length ? link.links : [link]
    );
  }
} catch {
  // A site without a header navigation still gets the home link below.
  links = [];
}

// Compare hrefs by normalized path, not string equality: the hardcoded Home
// link below is built via getHomePermalink() (goes through getPermalink's
// trailingSlash/BASE_PATHNAME logic), while a flattened `route`-kind NavTarget
// href is the raw stored string (createNavTargetResolver returns
// `target.href` verbatim for 'route' — see site-nav-targets.ts) — so "/" and
// a differently-normalized "/" (or an absolute variant) must still compare
// equal.
const stripTrailingSlash = (value: string) => (value.length > 1 && value.endsWith('/') ? value.slice(0, -1) : value);
const normalizeHref = (href: string): string => {
  if (/^[a-z][a-z0-9+.-]*:\/\//i.test(href)) {
    try {
      const url = new URL(href);
      return stripTrailingSlash(url.origin + url.pathname);
    } catch {
      return stripTrailingSlash(href);
    }
  }
  return stripTrailingSlash(href);
};
const homeHref = normalizeHref(getHomePermalink());
// A flattened dropdown (e.g. drlurie's titled "Start Here" group, or any
// site's titleless primary group) commonly surfaces the same "Home" entry
// the header always carries — see nav_header.json's g_start_here/g_primary
// i_home item on every site. The hardcoded Home link above already covers
// that destination, so drop it from the flattened list BEFORE truncating to
// 6 (truncating first would silently swallow a real 6th suggestion instead).
const suggestions = links
  .filter((link) => link.href && link.text && normalizeHref(link.href) !== homeHref)
  .slice(0, 6);
---

<nav class="mt-8 not-prose" aria-label="Suggested pages">
  <p class="text-sm text-muted">Try one of these instead:</p>
  <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-base">
    <li>
      <a class="text-link underline underline-offset-4 hover:opacity-80" href={getHomePermalink()}>Home</a>
    </li>
    {
      suggestions.map((link) => (
        <li>
          <a class="text-link underline underline-offset-4 hover:opacity-80" href={link.href}>
            {link.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

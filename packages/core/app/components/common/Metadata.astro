---
import merge from 'lodash.merge';
import { AstroSeo } from '@astrolib/seo';

import type { Props as AstroSeoProps } from '@astrolib/seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';
import { getSiteObject } from '~/utils/site-object';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

// SITE NOT YET LIVE: force noindex/nofollow on every page, unconditionally,
// regardless of site config or any per-page `robots` override. This is a
// single flag specifically so it can't be silently bypassed by a page (or a
// future CMS object) opting back into indexing before launch is intended.
// Flip to `false` when the site actually goes live.
const SITE_NOT_YET_LIVE = true;

// W4: the site object's metadataDefaults layer over the config.yaml layer —
// when the export is absent every field is undefined and lodash.merge skips
// it, leaving the config values (which the seed transcribes) in force.
const siteObject = getSiteObject();
const siteMeta = siteObject?.metadataDefaults;

const seoProps: AstroSeoProps = merge(
  {
    title: '',
    titleTemplate: '%s',
    canonical: canonical,
    noindex: true,
    nofollow: true,
    description: undefined,
    openGraph: {
      url: canonical,
      site_name: SITE?.name,
      images: [],
      locale: I18N?.language || 'en',
      type: 'website',
    },
    twitter: {
      cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary',
    },
  },
  {
    title: METADATA?.title?.default,
    titleTemplate: METADATA?.title?.template,
    noindex: typeof METADATA?.robots?.index !== 'undefined' ? !METADATA.robots.index : undefined,
    nofollow: typeof METADATA?.robots?.follow !== 'undefined' ? !METADATA.robots.follow : undefined,
    description: METADATA?.description,
    openGraph: METADATA?.openGraph,
    twitter: METADATA?.twitter,
  },
  {
    titleTemplate: siteMeta?.titleTemplate,
    description: siteMeta?.description,
    openGraph: siteObject
      ? { site_name: siteObject.name, ...(siteMeta ? { images: [{ url: siteMeta.ogImage }] } : {}) }
      : undefined,
    twitter: siteMeta?.twitterHandle ? { handle: siteMeta.twitterHandle, site: siteMeta.twitterHandle } : undefined,
  },
  {
    title: title,
    titleTemplate: ignoreTitleTemplate ? '%s' : undefined,
    canonical: canonical,
    noindex: typeof robots?.index !== 'undefined' ? !robots.index : undefined,
    nofollow: typeof robots?.follow !== 'undefined' ? !robots.follow : undefined,
    description: description,
    openGraph: { url: canonical, ...openGraph },
    twitter: twitter,
  }
);

if (SITE_NOT_YET_LIVE) {
  seoProps.noindex = true;
  seoProps.nofollow = true;
}
---

<AstroSeo {...{ ...seoProps, openGraph: await adaptOpenGraphImages(seoProps?.openGraph, Astro.site) }} />

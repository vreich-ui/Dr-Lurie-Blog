---
import '@site/config/policy-bindings'; // W11 T11.2: register site-identity provider before module-load getSiteIdentity()
import { getSiteIdentity } from '@core/lib/site-identity';

const favIcon = `${getSiteIdentity().assetHost}/favicon.png`;
---

<link rel="icon" type="image/png" href={favIcon} />
<link rel="shortcut icon" href={favIcon} />
<link rel="apple-touch-icon" sizes="180x180" href={favIcon} />
